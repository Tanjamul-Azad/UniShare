# ═══════════════════════════════════════════════════════════
#  UniShare — Environment Variables Reference
#  Copy to .env for local dev. Set these in Railway / Vercel
#  for production. Never commit your real .env file.
# ═══════════════════════════════════════════════════════════

# ── Server (Backend / Railway) ──────────────────────────────
PORT=3000
NODE_ENV=development

# Strong random string — generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production

# Comma-separated allowed origin for CORS. Set to your Vercel
# frontend URL in production, e.g. https://unishare.vercel.app
# Leave blank or * to allow all origins (fine for development).
ALLOWED_ORIGIN=*

# ── Firebase Admin SDK (Backend / Railway) ──────────────────
# Two options:
#   1. Path to the service-account JSON file (local dev only)
#      FIREBASE_SERVICE_ACCOUNT_JSON=backend/unishare-ea0db-firebase-adminsdk-fbsvc-7439f0b221.json
#   2. Paste the entire JSON as a single-line string (Railway prod)
#      FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── SSLCommerz Payment Gateway (Backend / Railway) ──────────
SSLCOMMERZ_STORE_ID=test67c71e227038e
SSLCOMMERZ_STORE_PASSWORD=test67c71e227038e@ssl
# Set to true only when you go live with a real SSLCommerz account
SSLCOMMERZ_IS_LIVE=false
# Public-facing backend URL used for payment callbacks
# e.g. https://unishare-backend.up.railway.app
BASE_URL=http://localhost:3000

# ── Email / SMTP (Backend / Railway) ────────────────────────
# If left blank, password-reset links are printed to server console.
# Recommended free options: Resend, Brevo, or Gmail App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UniShare <no-reply@unishare.app>

# ── Firebase Client SDK (Frontend / Vercel) ─────────────────
# These are safe to expose — Firebase restricts usage by domain.
VITE_FIREBASE_API_KEY=AIzaSyBCnPhRVYhCoaq1HzwgWgKo9qB5-lOwflY
VITE_FIREBASE_AUTH_DOMAIN=unishare-ea0db.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=unishare-ea0db
VITE_FIREBASE_STORAGE_BUCKET=unishare-ea0db.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=475565370360
VITE_FIREBASE_APP_ID=1:475565370360:web:abcbde37fb5cf7c2e1440d

# ── API & Socket (Frontend / Vercel) ────────────────────────
# Set both to your Railway backend URL in production.
# Leave blank for local dev (Vite proxy handles it automatically).

# Backend REST API root — must end with /api
# e.g. https://unishare-backend.up.railway.app/api
VITE_API_URL=

# Backend Socket.io root — no /api suffix
# e.g. https://unishare-backend.up.railway.app
VITE_SOCKET_URL=
